<Window x:Class="NEELx.Windows.UI.WelcomeBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome Back"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="340" Height="50"
        WindowStartupLocation="Manual">
    <Window.RenderTransform>
        <TranslateTransform x:Name="BannerTranslate" Y="-65"/>
    </Window.RenderTransform>
    <Border x:Name="BannerCard"
            Background="#E813151D"
            BorderBrush="#4530D158"
            BorderThickness="1"
            CornerRadius="24"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Emerald Checkmark Badge -->
            <Border Width="22" Height="22" CornerRadius="11" Background="#2630D158" Margin="0,0,10,0">
                <Path Data="M 4,8 L 7,11 L 13,5" Stroke="#30D158" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="WelcomeText" Text="Welcome Back, User!" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
