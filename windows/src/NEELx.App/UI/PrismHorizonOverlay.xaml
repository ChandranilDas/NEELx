<Window x:Class="NEELx.Windows.UI.PrismHorizonOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEELx Prism Core"
        Width="252"
        Height="226"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid Margin="14">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="CardShakeTransform" X="0" Y="0"/>
        </Grid.RenderTransform>

        <!-- Obsidian Fluent Mica Floating Prism Core Card (Distinct from macOS/iPhone Notch) -->
        <Border x:Name="BladeBorder"
                CornerRadius="26"
                Background="#F2080A0F"
                BorderThickness="1.25"
                BorderBrush="#4438BDF8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.72"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Subtle Top Atmospheric Aura -->
                <Ellipse x:Name="AmbientAura"
                         Grid.RowSpan="2"
                         Width="170"
                         Height="170"
                         VerticalAlignment="Top"
                         Margin="0,-55,0,0"
                         Opacity="0.24"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="AuraCoreStop" Color="#FF38BDF8" Offset="0"/>
                            <GradientStop Color="#0038BDF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Kinetic 3D Orbital Prism & Fluent Biometric Face Stage -->
                <Canvas Grid.Row="0" Width="136" Height="136" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                    <!-- 3D Tilted Orbital Ring 1 (Gyroscopic perspective motion) -->
                    <Ellipse x:Name="OrbitRingA"
                             Width="112" Height="112"
                             Canvas.Left="12" Canvas.Top="12"
                             Stroke="#CC38BDF8"
                             StrokeThickness="3.2"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="OrbitGlowA" Color="#38BDF8" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="OrbitScaleA" ScaleX="1" ScaleY="0.46"/>
                                <RotateTransform x:Name="OrbitRotateA" Angle="25"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- 3D Tilted Orbital Ring 2 (Counter-tilted sapphire-indigo orbit) -->
                    <Ellipse x:Name="OrbitRingB"
                             Width="112" Height="112"
                             Canvas.Left="12" Canvas.Top="12"
                             Stroke="#B8818CF8"
                             StrokeThickness="2.6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="OrbitGlowB" Color="#818CF8" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="OrbitScaleB" ScaleX="0.46" ScaleY="1"/>
                                <RotateTransform x:Name="OrbitRotateB" Angle="-25"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Luminous Circular Verification Ring (Shown ONLY on Verified Unlock / Spoof Block) -->
                    <Ellipse x:Name="StatusCircleRing"
                             Width="112" Height="112"
                             Canvas.Left="12" Canvas.Top="12"
                             Stroke="#FF30D158"
                             StrokeThickness="3.8"
                             Fill="#1230D158"
                             Opacity="0">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="StatusCircleGlow" Color="#30D158" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Sculpted Fluent Biometric Face Emblem (Visible during Scanning / Backlit HDR) -->
                    <Canvas x:Name="FluentFaceGroup" Width="136" Height="136" Opacity="1">
                        <!-- Sculpted Head Contour -->
                        <Path x:Name="FaceContourPath"
                              Data="M 68,36 C 85,36 91,50 89,66 C 87,81 78,94 68,96 C 58,94 49,81 47,66 C 45,50 51,36 68,36 Z"
                              Stroke="#E6F0FAFF"
                              StrokeThickness="2.2"
                              Fill="#1438BDF8"
                              StrokeLineJoin="Round"/>
                        <!-- Brows -->
                        <Path Data="M 54,56 Q 59,53 64,56 M 72,56 Q 77,53 82,56"
                              Stroke="#D838BDF8"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <!-- Eyes -->
                        <Ellipse Width="5" Height="5" Canvas.Left="56.5" Canvas.Top="60.5" Fill="#FFF5F7FA"/>
                        <Ellipse Width="5" Height="5" Canvas.Left="74.5" Canvas.Top="60.5" Fill="#FFF5F7FA"/>
                        <!-- 3D Protruding Nose Bridge & Tip -->
                        <Path Data="M 68,58 L 68,72 Q 65,75 63.5,73.5 M 68,72 Q 71,75 72.5,73.5"
                              Stroke="#FFF5F7FA"
                              StrokeThickness="2.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <!-- Calm Sculpted Mouth -->
                        <Path Data="M 60,82 Q 68,86 76,82"
                              Stroke="#E6F0FAFF"
                              StrokeThickness="2.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>

                        <!-- Horizontal Depth-Scan Laser Beam Sweeping Down the Face -->
                        <Rectangle x:Name="FaceScanBeam"
                                   Width="76"
                                   Height="2.4"
                                   RadiusX="1.2"
                                   RadiusY="1.2"
                                   Canvas.Left="30"
                                   Canvas.Top="40">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0038BDF8" Offset="0"/>
                                    <GradientStop x:Name="ScanBeamStop" Color="#FF38BDF8" Offset="0.5"/>
                                    <GradientStop Color="#00818CF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>

                    <!-- Emerald Verified Checkmark Glyph (Traces smoothly on Unlock) -->
                    <Path x:Name="VerifiedCheckPath"
                          Data="M 46,69 L 61,84 L 91,52"
                          Stroke="#FF30D158"
                          StrokeThickness="5.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Opacity="0">
                        <Path.Effect>
                            <DropShadowEffect Color="#30D158" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                        </Path.Effect>
                    </Path>

                    <!-- Coral-Amber Spoof Rejection Cross Glyph -->
                    <Path x:Name="SpoofCrossPath"
                          Data="M 50,50 L 86,86 M 86,50 L 50,86"
                          Stroke="#FFFB7185"
                          StrokeThickness="4.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Opacity="0">
                        <Path.Effect>
                            <DropShadowEffect Color="#FB7185" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                        </Path.Effect>
                    </Path>
                </Canvas>

                <!-- Minimal Refined Telemetry Pill -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="12,0,12,14">
                    <TextBlock x:Name="PrimaryStatusText"
                               Text="PRISM 3D · SCANNING"
                               HorizontalAlignment="Center"
                               Foreground="#FFF5F7FA"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="11.5"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SecondaryStatusText"
                               Text="DirectML GPU · 3D Depth Active"
                               HorizontalAlignment="Center"
                               Foreground="#FF8E97A8"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
