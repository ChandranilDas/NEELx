<Application x:Class="NEELx.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Deep Dark macOS & Fluent Mica Brushes -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#FF121317"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#E6181920"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FF1C1D24"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="TabBarBgBrush" Color="#EB20222B"/>
        <SolidColorBrush x:Key="TabBarBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#FF343644"/>

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF30D158"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="AccentIndigoBrush" Color="#FF818CF8"/>
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFFBBF24"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="#FFFB7185"/>

        <!-- Typography -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEEEEEF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A3AF"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6E7280"/>

        <!-- Legacy Brushes for backward compatibility with overlay -->
        <SolidColorBrush x:Key="MicaBaseBrush" Color="#FF121317"/>
        <SolidColorBrush x:Key="MicaSurfaceBrush" Color="#FF181920"/>
        <SolidColorBrush x:Key="MicaCardBrush" Color="#FF1C1D24"/>
        <SolidColorBrush x:Key="MicaStrokeBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="PrismEmeraldBrush" Color="#FF30D158"/>
        <SolidColorBrush x:Key="PrismCyanBrush" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="PrismIndigoBrush" Color="#FF818CF8"/>
        <SolidColorBrush x:Key="PrismAmberBrush" Color="#FFFBBF24"/>

        <!-- macOS / iOS Style Toggle Switch (styled from CheckBox) -->
        <Style x:Key="MacToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#FF343744"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="#FFF8FAFC"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF30D158"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#4430D158"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Style Pill Button -->
        <Style x:Key="MacPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF272A36"/>
            <Setter Property="Foreground" Value="#FFEEEEEF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF323645"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF20222B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
