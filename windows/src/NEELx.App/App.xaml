<Application x:Class="NEELx.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MicaBaseBrush" Color="#FF0F1115"/>
        <SolidColorBrush x:Key="MicaSurfaceBrush" Color="#FF181B22"/>
        <SolidColorBrush x:Key="MicaCardBrush" Color="#FF1E222B"/>
        <SolidColorBrush x:Key="MicaStrokeBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="PrismEmeraldBrush" Color="#FF30D158"/>
        <SolidColorBrush x:Key="PrismCyanBrush" Color="#FF38BDF8"/>
        <SolidColorBrush x:Key="PrismIndigoBrush" Color="#FF818CF8"/>
        <SolidColorBrush x:Key="PrismAmberBrush" Color="#FFFBBF24"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA1A7B3"/>
    </Application.Resources>
</Application>
