<Window x:Class="NEELx.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEELx for Windows 11 — Fluent Prism Edition"
        Width="780"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        Background="{StaticResource MicaBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="NEELx · Windows 11 Edition"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="100% Offline 3D Biometric Unlock for Standard Webcams · DirectML + DPAPI"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Padding="12,6"
                    Background="#1830D158"
                    BorderBrush="#4430D158"
                    BorderThickness="1">
                <TextBlock x:Name="AcceleratorBadge"
                           Text="DirectML Ready"
                           Foreground="{StaticResource PrismEmeraldBrush}"
                           FontSize="11.5"
                           FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <!-- Prism Horizon Live Preview Bar -->
        <Border Grid.Row="1"
                CornerRadius="14"
                Background="{StaticResource MicaCardBrush}"
                BorderBrush="{StaticResource MicaStrokeBrush}"
                BorderThickness="1"
                Padding="18"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="FLUENT PRISM HORIZON OVERLAY"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrismCyanBrush}"/>
                <TextBlock Text="Preview the dedicated Windows 11 top-edge faceted diamond-iris &amp; horizontal laser unlock blade (distinct from macOS's circular notch Face ID)."
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,14"/>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="Preview Scanning" Click="OnPreviewScanClick" Margin="0,0,10,8" Padding="14,8" Background="#FF1E293B" Foreground="#FFF8FAFC" BorderBrush="#4438BDF8"/>
                    <Button Content="Preview Backlit HDR" Click="OnPreviewBacklitClick" Margin="0,0,10,8" Padding="14,8" Background="#FF272115" Foreground="#FFFDE68A" BorderBrush="#55FBBF24"/>
                    <Button Content="Preview Verified Unlock" Click="OnPreviewVerifiedClick" Margin="0,0,10,8" Padding="14,8" Background="#FF12281B" Foreground="#FF86EFAC" BorderBrush="#5530D158"/>
                    <Button Content="Preview 2D Spoof Block" Click="OnPreviewSpoofClick" Margin="0,0,10,8" Padding="14,8" Background="#FF2A141A" Foreground="#FFFDA4AF" BorderBrush="#55FB7185"/>
                    <Button Content="Hide Overlay" Click="OnHideOverlayClick" Margin="0,0,0,8" Padding="14,8" Background="#FF181B22" Foreground="#FFA1A7B3" BorderBrush="#33FFFFFF"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Security & Architecture Grid -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,18">
            <Border CornerRadius="14" Background="{StaticResource MicaSurfaceBrush}" BorderBrush="{StaticResource MicaStrokeBrush}" BorderThickness="1" Padding="18" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="3D Neural Depth Engine" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DepthEngineStatusText"
                               Text="ONNX Runtime DirectML · ArcFace 512-D + DepthAnythingV2Small + Multi-Frame Temporal Consistency (2 consecutive frames required)."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <CheckBox Content="Backlit Window HDR Shadow Recovery" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,6"/>
                    <CheckBox Content="Multi-Frame Temporal Depth Consistency" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <CheckBox Content="Subtle Unlock Chime" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="14" Background="{StaticResource MicaSurfaceBrush}" BorderBrush="{StaticResource MicaStrokeBrush}" BorderThickness="1" Padding="18" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="DPAPI Vault &amp; WinLogon Bridge" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="VaultStatusText"
                               Text="Offline DPAPI vault ready in %LOCALAPPDATA%\NEELx. Zero cloud calls or telemetry."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <Button Content="Test Temporal Depth &amp; DPAPI Pipeline"
                            Click="OnRunSelfCheckClick"
                            Margin="0,16,0,8"
                            Padding="14,9"
                            Background="#FF163322"
                            Foreground="#FF86EFAC"
                            BorderBrush="#6630D158"/>
                    <TextBlock x:Name="SelfCheckOutput"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource PrismCyanBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="NEELx v2.0.0-beta.5 · MIT Open Source · Runs on Windows 11 (x64 &amp; ARM64) with any standard webcam."
                   FontSize="11.5"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</Window>
