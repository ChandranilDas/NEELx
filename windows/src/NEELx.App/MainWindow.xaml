<Window x:Class="NEELx.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEELx for Windows 11"
        Icon="Assets/neelx.ico"
        Width="540"
        Height="680"
        MinWidth="520"
        MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Outer Window Card with macOS / Mica Curvature & Soft Border -->
    <Border CornerRadius="18"
            Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        
        <Grid>
            <!-- 1. Header Bar (Draggable, with macOS Traffic Lights & Session Pill) -->
            <Grid Height="52" VerticalAlignment="Top" Background="{StaticResource HeaderBgBrush}" MouseDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- macOS Traffic Lights & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Click="OnCloseClick" Width="12" Height="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Close" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Ellipse Fill="#FF5F56" Width="12" Height="12"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="OnMinimizeClick" Width="12" Height="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Minimize" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Ellipse Fill="#FFBD2E" Width="12" Height="12"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="OnMaximizeClick" Width="12" Height="12" Margin="0,0,14,0" Cursor="Hand" ToolTip="Zoom" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Ellipse Fill="#FF27C93F" Width="12" Height="12"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Image Source="Assets/neelx-logo.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NEELx" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="· Windows 11" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="6,1,0,0"/>
                </StackPanel>

                <!-- Trailing Session Lock Pill -->
                <Button Grid.Column="2" Click="OnSessionLockClick" Margin="0,0,16,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border x:Name="SessionPill"
                                    Background="#FF20222B"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                    <!-- Padlock Icon -->
                                    <Path Data="M 3,5 L 3,3 C 3,1.34 4.34,0 6,0 C 7.66,0 9,1.34 9,3 L 9,5 L 10,5 C 10.55,5 11,5.45 11,6 L 11,11 C 11,11.55 10.55,12 10,12 L 2,12 C 1.45,12 1,11.55 1,11 L 1,6 C 1,5.45 1.45,5 2,5 Z M 4.2,5 L 7.8,5 L 7.8,3 C 7.8,2.01 6.99,1.2 6,1.2 C 5.01,1.2 4.2,2.01 4.2,3 Z"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Width="9" Height="10"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"/>
                                    <TextBlock x:Name="SessionText" Text="Session unlocked" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SessionPill" Property="Background" Value="#FF292B37"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Scrollable Body Content -->
            <ScrollViewer Margin="0,52,0,74" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22,14,22,20">
                    
                    <!-- TAB 1: GENERAL -->
                    <StackPanel x:Name="PageGeneral" Visibility="Visible">
                        <!-- Group 1: Master Unlock -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Enable Face Unlock" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Automatically detects and unlocks your PC when you sit down at your desk." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Unlock with Spacebar only" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Arm biometric scan only when Spacebar or any key is pressed on the lock screen." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="300">
                                        <TextBlock Text="Welcome Back Notification" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Show a floating &quot;Welcome Back (Name)!&quot; popup message at the top of the screen right after unlocking." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Click="OnPreviewWelcomeClick" Content="Preview" Margin="0,0,10,0" Padding="8,3" Background="#20FFFFFF" Foreground="{StaticResource AccentGreenBrush}" BorderBrush="#30FFFFFF" BorderThickness="1" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <CheckBox x:Name="ToggleWelcomeBanner" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}" Checked="OnWelcomeBannerToggled" Unchecked="OnWelcomeBannerToggled"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: System & Visual Experience -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Launch at Windows Startup" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Start NEELx background biometric service when signing into Windows." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Studio Light Display Halo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Smoothly boosts display perimeter in dim rooms for instant camera face detection." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Subtle Unlock Chime" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Plays a muted glass chime when biometric unlock succeeds." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Unlock Overlay Architecture Preview -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="UNLOCK OVERLAY (WINDOWS 11 PRISM HORIZON)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Top-edge faceted laser blade &amp; dual tilted orbital rings (distinct from macOS notch)." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Preview Scanning" Click="OnPreviewScanClick" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,8,6"/>
                                    <Button Content="Preview Verified" Click="OnPreviewVerifiedClick" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,8,6" Background="#FF163322" Foreground="#FF86EFAC"/>
                                    <Button Content="Preview Spoof Block" Click="OnPreviewSpoofClick" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,8,6" Background="#FF331920" Foreground="#FFFDA4AF"/>
                                    <Button Content="Dismiss" Click="OnHideOverlayClick" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: RECOGNITION -->
                    <StackPanel x:Name="PageRecognition" Visibility="Collapsed">
                        <!-- Group 1: Match Confidence & Distance -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Match confidence" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="MatchConfidenceLabel" DockPanel.Dock="Right" Text="Default" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource AccentCyanBrush}"/>
                                </DockPanel>
                                <Slider x:Name="MatchConfidenceSlider" Minimum="0" Maximum="2" Value="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnMatchConfidenceChanged" Margin="0,0,0,4"/>
                                <Grid>
                                    <TextBlock Text="Less strict" HorizontalAlignment="Left" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="Default" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="More strict" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,12"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Detection distance" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="DetectionDistanceLabel" DockPanel.Dock="Right" Text="Default" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource AccentCyanBrush}"/>
                                </DockPanel>
                                <Slider x:Name="DetectionDistanceSlider" Minimum="0" Maximum="2" Value="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnDetectionDistanceChanged" Margin="0,0,0,4"/>
                                <Grid>
                                    <TextBlock Text="Close" HorizontalAlignment="Left" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="Default" HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="Far" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Liveness & 3D Depth Engine (Hardcoded Core Security) -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="3D Neural Depth (DirectML)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Depth Anything V2 analyzes 3D nose protrusion and facial curvature on DirectML GPU/NPU." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Always on" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Multi-Frame Temporal Depth Consistency" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Requires 2 consecutive physically consistent 3D readings to eliminate flat photo/screen attacks." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Always on" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Active Chromatic Flash" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Flashes a brief color pulse in low light to verify live skin reflection and defeat 4K replays." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Silent Adaptive Learning" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Automatically adapts to gradual changes (glasses, beard, lighting) from 3D-verified unlocks." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Encrypted Security Audit Log -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Encrypted Security Audit Log" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Logs unlock events and encrypted snapshots strictly offline under Windows DPAPI key." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <!-- Audit List Preview -->
                                <StackPanel>
                                    <!-- Entry 1 -->
                                    <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Unlocked" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Matched Neel at 0.787, 3D Depth 95% · Profile 97% (DirectML 18ms)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Today 8:03 PM" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Entry 2 -->
                                    <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentRedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Spoof blocked" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}"/>
                                                <TextBlock Text="A device-shaped rectangle was detected around the face — 2D spoof blocked" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Today 7:41 PM" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Entry 3 -->
                                    <Border Background="#12FFFFFF" CornerRadius="10" Padding="12,10">
                                        <DockPanel>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Unlocked" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Matched Neel at 0.803, 3D Depth 100% · Profile 98% (DirectML 22ms)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Today 7:29 PM" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: YOUR FACE -->
                    <StackPanel x:Name="PageYourFace" Visibility="Collapsed">
                        <!-- Enrolled Identity Profile Card -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Sculpted Face ID Avatar Icon -->
                                <Border Width="76" Height="76" CornerRadius="38" Background="#FF282B37" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="2" Margin="0,0,0,12">
                                    <Grid>
                                        <Image Source="Assets/neelx-logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Neel" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Active Biometric Profile · 9 Poses · 3D Facial Relief Stored" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Re-enroll Face" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,10,0" Padding="16,8"/>
                                    <Button Content="Reset Biometrics" Style="{StaticResource MacPillButtonStyle}" Background="#FF331920" Foreground="{StaticResource AccentRedBrush}" Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="BIOMETRIC COVERAGE &amp; DRIFT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Your face is enrolled with 9 spatial poses plus personal 3D depth topography. Silent Adaptive Learning smoothly updates appearance drifts (lighting, beard, glasses) upon 3D-verified unlocks." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 4: SECURITY & DPAPI -->
                    <StackPanel x:Name="PageSecurity" Visibility="Collapsed">
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="WINDOWS DPAPI CREDENTIAL VAULT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Encrypted strictly offline under your Windows User Master Key (DPAPI). Zero cloud transmission, zero telemetry." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Border Background="#12FFFFFF" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock Text="%LOCALAPPDATA%\NEELx (Preserved Across Upgrades)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Change Unlock Password" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="Run DPAPI Self-Check" Click="OnRunSelfCheckClick" Style="{StaticResource MacPillButtonStyle}" Background="#FF163322" Foreground="#FF86EFAC"/>
                                </WrapPanel>
                                <TextBlock x:Name="SelfCheckOutput" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="WINLOGON &amp; AUTO-LOCK" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Seamless Windows 11 lock screen integration. Instantly injects cached DPAPI credential into LogonUI on verified face detection." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 5: CAMERA -->
                    <StackPanel x:Name="PageCamera" Visibility="Collapsed">
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" Text="Camera Source" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Refresh Cameras" Style="{StaticResource MacPillButtonStyle}" HorizontalAlignment="Right" Padding="12,5"/>
                                </DockPanel>

                                <!-- Camera Selector Box -->
                                <Border Background="#FF252733" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <DockPanel>
                                        <TextBlock Text="Integrated Webcam (1920x1080 @ 30 FPS)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Phone Camera (Desk Stand / Studio Optics) -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PHONE CAMERA (DESK STAND / STUDIO OPTICS)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Use Phone Camera (iPhone &amp; Android)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Uses connected iPhone or Android (Android 14+ USB webcam or Camo) for studio optics. Works on any desk stand, wireless charger, or kickstand — no laptop clip required!" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Dual-Path Concurrent Unlock" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Polls both laptop webcam and phone camera concurrently — unlocks from whichever sees you first." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12"/>

                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="320">
                                        <TextBlock Text="Bluetooth LE Dynamic Proximity Guard" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Requires your paired phone to be within arm's reach (&lt; 1.5m) to enable biometric unlock." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox DockPanel.Dock="Right" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource MacToggleSwitchStyle}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>



                        <!-- Simulated Camera Viewfinder -->
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16" Height="220">
                            <Grid>
                                <Border Background="#FF181920" CornerRadius="10">
                                    <Grid>
                                        <!-- Face Oval Guide -->
                                        <Ellipse Width="100" Height="130" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.5" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Camera Preview Ready · DirectShow RGB Stream" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- TAB 6: ABOUT -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="24" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="Assets/neelx-logo.png" Width="64" Height="64" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="NEELx" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Windows 11 Edition · Fluent Prism" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                                <TextBlock Text="Version 2.0.0-beta.11 (x64 &amp; ARM64)" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                <TextBlock Text="100% Offline 3D Biometric Face Unlock using standard webcams." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="GitHub Repository" Click="OnOpenGitHubClick" Style="{StaticResource MacPillButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="Official Website" Click="OnOpenWebsiteClick" Style="{StaticResource MacPillButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Licensed under the MIT License · Built with DirectML, ONNX Runtime, and WPF." FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- 3. Floating Bottom Tab Bar (macOS SettingsTabBar Style) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    CornerRadius="24"
                    Height="48"
                    Background="{StaticResource TabBarBgBrush}"
                    BorderBrush="{StaticResource TabBarBorderBrush}"
                    BorderThickness="1"
                    Padding="6,4">
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Tab 1: General -->
                    <Button x:Name="TabBtnGeneral" Click="OnTabGeneralClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="{StaticResource TabSelectedBrush}" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Gear Icon -->
                                        <Path Data="M 12,15.5 C 10.07,15.5 8.5,13.93 8.5,12 C 8.5,10.07 10.07,8.5 12,8.5 C 13.93,8.5 15.5,10.07 15.5,12 C 15.5,13.93 13.93,15.5 12,15.5 Z M 19.43,12.97 C 19.47,12.65 19.5,12.33 19.5,12 C 19.5,11.67 19.47,11.34 19.43,11.03 L 21.54,9.37 C 21.73,9.22 21.78,8.95 21.66,8.73 L 19.66,5.27 C 19.54,5.05 19.27,4.96 19.05,5.05 L 16.56,6.05 C 16.04,5.66 15.5,5.32 14.87,5.07 L 14.49,2.42 C 14.46,2.18 14.25,2 14,2 L 10,2 C 9.75,2 9.54,2.18 9.51,2.42 L 9.13,5.07 C 8.5,5.32 7.96,5.66 7.44,6.05 L 4.95,5.05 C 4.73,4.96 4.46,5.05 4.34,5.27 L 2.34,8.73 C 2.21,8.95 2.27,9.22 2.46,9.37 L 4.57,11.03 C 4.53,11.34 4.5,11.67 4.5,12 C 4.5,12.33 4.53,12.65 4.57,12.97 L 2.46,14.63 C 2.27,14.78 2.21,15.05 2.34,15.27 L 4.34,18.73 C 4.46,18.95 4.73,19.03 4.95,18.95 L 7.44,17.95 C 7.96,18.34 8.5,18.68 9.13,18.93 L 9.51,21.58 C 9.54,21.82 9.75,22 10,22 L 14,22 C 14.25,22 14.46,21.82 14.49,21.58 L 14.87,18.93 C 15.5,18.67 16.04,18.34 16.56,17.95 L 19.05,18.95 C 19.27,19.04 19.54,18.95 19.66,18.73 L 21.66,15.27 C 21.78,15.05 21.73,14.78 21.54,14.63 Z"
                                              Fill="{StaticResource TextPrimaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtGeneral" Text="General" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 2: Recognition -->
                    <Button x:Name="TabBtnRecognition" Click="OnTabRecognitionClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Sparkle Icon -->
                                        <Path Data="M 12,2 L 14.5,9.5 L 22,12 L 14.5,14.5 L 12,22 L 9.5,14.5 L 2,12 L 9.5,9.5 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtRecognition" Text="Recognition" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 3: Your Face -->
                    <Button x:Name="TabBtnYourFace" Click="OnTabYourFaceClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- User / Face Icon -->
                                        <Path Data="M 12,12 C 14.21,12 16,10.21 16,8 C 16,5.79 14.21,4 12,4 C 9.79,4 8,5.79 8,8 C 8,10.21 9.79,12 12,12 Z M 12,14 C 9.33,14 4,15.34 4,18 L 4,20 L 20,20 L 20,18 C 20,15.34 14.67,14 12,14 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtYourFace" Text="Your Face" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 4: Security -->
                    <Button x:Name="TabBtnSecurity" Click="OnTabSecurityClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Shield Icon -->
                                        <Path Data="M 12,1 L 3,5 L 3,11 C 3,16.55 6.84,21.74 12,23 C 17.16,21.74 21,16.55 21,11 L 21,5 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="13" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtSecurity" Text="Security" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 5: Camera -->
                    <Button x:Name="TabBtnCamera" Click="OnTabCameraClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Video Camera Icon -->
                                        <Path Data="M 17,10.5 L 17,7 C 17,6.45 16.55,6 16,6 L 4,6 C 3.45,6 3,6.45 3,7 L 3,17 C 3,17.55 3.45,18 4,18 L 16,18 C 16.55,18 17,17.55 17,17 L 17,13.5 L 21,17.5 L 21,6.5 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtCamera" Text="Camera" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 6: About -->
                    <Button x:Name="TabBtnAbout" Click="OnTabAboutClick" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="18" Padding="12,6" Margin="2,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Info Icon -->
                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 13,17 L 11,17 L 11,11 L 13,11 Z M 13,9 L 11,9 L 11,7 L 13,7 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtAbout" Text="About" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
